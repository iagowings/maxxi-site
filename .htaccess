# Apache / Hostinger config — clean URLs + 301 redirects for SEO migration.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + www (canonical host)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.maxxisaude.com%{REQUEST_URI} [L,R=301]

  # --- Legacy flat .html URLs from the old prototype ---
  RewriteRule ^index\.html$              /                          [L,R=301]
  RewriteRule ^especialidades\.html$     /especialidades/           [L,R=301]
  RewriteRule ^tecnologia\.html$         /tomografia-128-canais/    [L,R=301]
  RewriteRule ^sobre\.html$              /sobre/                    [L,R=301]
  RewriteRule ^resultados\.html$         /resultados/               [L,R=301]
  RewriteRule ^faq\.html$                /faq/                      [L,R=301]
  RewriteRule ^contato\.html$            /contato/                  [L,R=301]

  # --- Legacy WordPress pages with no dedicated page in this site ---
  RewriteRule ^fale-conosco/?$           /contato/                  [L,R=301]
  RewriteRule ^altamira/?$               /                          [L,R=301]
  RewriteRule ^cestrelas/?$              /                          [L,R=301]
  RewriteRule ^obrigado-mulher/?$        /                          [L,R=301]
  RewriteRule ^obrigado-voucher/?$       /                          [L,R=301]

  # --- Enforce trailing slash on directory-style URLs (no file extension) ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]+|/)$
  RewriteRule ^(.+)$ /$1/ [L,R=301]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
